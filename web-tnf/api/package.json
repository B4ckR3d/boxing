{
  "name": "@tfn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TFN API (Express + TypeScript) \u2014 target backend hasil strangler (ADR-001)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@tfn/db=../packages/db/src/index.ts --alias:@tfn/db/client=../packages/db/src/generated/prisma/client.ts --alias:@tfn/db/enums=../packages/db/src/generated/prisma/enums.ts --alias:@tfn/ticketing=../packages/ticketing/src/ticketing.service.ts --alias:@tfn/ticketing/pdf=../packages/ticketing/src/ticket-pdf.service.ts --alias:@tfn/ticketing/token=../packages/ticketing/src/ticket-token.ts --alias:@tfn/ticketing/identity=../packages/ticketing/src/buyer-identity.ts --alias:@tfn/ticketing/labels=../packages/ticketing/src/labels.ts --alias:@tfn/core=../packages/core/src/index.ts --alias:@tfn/core/audit=../packages/core/src/audit.service.ts --alias:@tfn/core/settings=../packages/core/src/settings.service.ts --alias:@tfn/core/sponsors=../packages/core/src/sponsor.service.ts --alias:@tfn/core/redact=../packages/core/src/redact.ts --alias:@tfn/core/setting-schemas=../packages/core/src/setting-schemas.ts --alias:@tfn/core/sponsor-tiers=../packages/core/src/sponsor-tiers.ts --alias:@tfn/auth=../packages/auth/src/index.ts --alias:@tfn/auth/catalog=../packages/auth/src/catalog.ts --alias:@tfn/auth/password=../packages/auth/src/password.ts --alias:@tfn/auth/account-policy=../packages/auth/src/account-policy.ts --alias:@tfn/auth/rate-limit=../packages/auth/src/rate-limit.ts --alias:@tfn/auth/permissions=../packages/auth/src/permissions.ts --alias:@tfn/auth/session=../packages/auth/src/session.ts --alias:@tfn/auth/session-service=../packages/auth/src/session.service.ts --alias:@tfn/auth/rbac-service=../packages/auth/src/rbac.service.ts --alias:@tfn/auth/crypto=../packages/auth/src/crypto.ts --alias:@tfn/auth/totp=../packages/auth/src/totp.ts --sourcemap --outfile=dist/index.js",
    "start:prod": "node dist/index.js",
    "verify:dist": "pnpm build && node scripts/smoke-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --schema ../prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema ../prisma/schema.prisma",
    "db:studio": "prisma studio --schema ../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tfn/db": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "server-only": "^0.0.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7",
    "@tfn/ticketing": "workspace:*",
    "@tfn/core": "workspace:*",
    "@tfn/auth": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
