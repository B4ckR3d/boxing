{
  "name": "web-tnf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TFN Web — project mandiri (Next.js 16 App Router). Paket db/core/auth/ticketing ada di packages/ dalam folder ini.",
  "scripts": {
    "dev": "next dev",
    "api:dev": "pnpm --filter @tfn/api dev",
    "api:build": "pnpm --filter @tfn/api build",
    "api:start": "pnpm --filter @tfn/api start:prod",
    "worker:expire": "pnpm --filter @tfn/worker expire-holds",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:e2e": "node scripts/verify/e2e-ui.cjs",
    "verify:e2e:final": "node scripts/verify/e2e-final.cjs",
    "verify:layout": "node scripts/verify/layout.cjs",
    "verify:shots": "node scripts/verify/shots.cjs",
    "verify:probe": "node scripts/verify/layout.cjs && node scripts/verify/e2e-ui.cjs && node scripts/verify/e2e-final.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@hookform/resolvers": "^5.2.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.90.0",
    "@tfn/db": "workspace:*",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.0",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.0",
    "next": "16.4.5",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.66.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "@tfn/ticketing": "workspace:*",
    "@tfn/core": "workspace:*",
    "@tfn/auth": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
