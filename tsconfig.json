{
  "//": "tsconfig root hanya untuk skrip ops (scripts/, prisma/seed.ts). Aplikasi Next punya tsconfig sendiri di apps/web. TIDAK ada lagi paths @/* ke apps/web: skrip ops memakai paket @tfn/* (Langkah E).",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["node_modules", "apps", "packages", ".next"]
}
