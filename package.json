{
  "name": "tfn-monorepo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @tfn/web dev",
    "build": "pnpm --filter @tfn/web build",
    "start": "pnpm --filter @tfn/web start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "pnpm --filter @tfn/web test:unit",
    "test:integration": "pnpm --filter @tfn/web test:integration",
    "test:all": "pnpm --filter @tfn/web test:all",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:wait": "node scripts/wait-for-db.mjs",
    "db:setup": "pnpm db:wait && pnpm db:deploy && pnpm db:seed",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:backup": "node scripts/db-backup.mjs",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "user:reset-password": "tsx scripts/reset-password.ts",
    "ticketing:expire-holds": "NODE_OPTIONS=--conditions=react-server tsx scripts/expire-holds.ts",
    "postinstall": "prisma generate || true",
    "turbo:verify": "turbo run typecheck lint test verify:dist",
    "api:dev": "pnpm --filter @tfn/api dev",
    "api:test": "pnpm --filter @tfn/api test"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tfn/db": "workspace:*",
    "dotenv": "^17.2.0",
    "tsx": "^4.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "prisma": "7.10.1",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.10.1"
}
