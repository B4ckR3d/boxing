{
  "name": "@tfn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TFN API (Express + TypeScript) — target backend hasil strangler (ADR-001)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@tfn/db=../../packages/db/src/index.ts --alias:@tfn/db/client=../../packages/db/src/generated/prisma/client.ts --alias:@tfn/db/enums=../../packages/db/src/generated/prisma/enums.ts --sourcemap --outfile=dist/index.js",
    "start:prod": "node dist/index.js",
    "verify:dist": "pnpm build && node scripts/smoke-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "db:studio": "prisma studio --schema ../../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tfn/db": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
