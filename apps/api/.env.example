# Salin ke apps/api/.env hanya bila perlu override; nilai default membaca ../.env (root).
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
LOG_LEVEL=info

# Database (sama dengan root app — ADR-009). Bisa diisi lewat DATABASE_URL saja.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=boxing
MYSQL_USER=boxing
MYSQL_PASSWORD=
DATABASE_POOL_SIZE=10

# Dokumentasi API
OPENAPI_ENABLED=true

# --- Auth & sesi (WAJIB) ---------------------------------------------------
# Nilai di bawah HARUS identik dengan apps/web. Kalau tidak:
#   - AUTH_SECRET beda  -> tiket PDF/QR yang terbit di web gagal diverifikasi (HMAC offline)
#   - ENCRYPTION_KEY beda -> semua akun ber-MFA GAGAL LOGIN lewat API (mfaSecretEnc tak bisa didekripsi)
# Generate ENCRYPTION_KEY:  openssl rand -base64 32
# Generate AUTH_SECRET:     openssl rand -base64 48
# Keduanya sudah ada di .env root; isi di sini hanya bila ingin override.
# API menolak start (fail fast) bila ENCRYPTION_KEY kosong atau bukan base64 32 byte.
AUTH_SECRET=
ENCRYPTION_KEY=
# Dipakai apps/web untuk memanggil apps/api (BFF /api/auth/*). Default sudah benar untuk VPS
# satu mesin: http://127.0.0.1:4000. Isi hanya bila API berada di host/port lain.
API_INTERNAL_URL=http://127.0.0.1:4000
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
# Production: true. Mewajibkan TOTP untuk role ber-flag requiresMfa (Super Admin).
AUTH_ENFORCE_MFA=false
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
