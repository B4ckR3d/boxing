# =============================================================================
# Boxing Championship Platform — environment variables
# Copy to `.env` and fill in values. NEVER commit real secrets.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# =============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=development
# Public canonical URL (used for canonical links, sitemap, OG, CSRF origin check)
APP_URL=http://localhost:3000

# --- Database (MySQL 8) ------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=boxing
MYSQL_USER=boxing
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# Prisma CLI (migrations) connection string — must match the values above
DATABASE_URL=mysql://boxing:change-me@localhost:3307/boxing
# Pool size for the runtime adapter
DATABASE_POOL_SIZE=10

# --- Security ----------------------------------------------------------------
# 32-byte base64 key used for HMAC (CSRF tokens) — REQUIRED
AUTH_SECRET=
# 32-byte base64 key used for AES-256-GCM encryption of TOTP secrets — REQUIRED
ENCRYPTION_KEY=
# Session lifetime (hours) and idle timeout (minutes)
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
# Enforce TOTP MFA for roles flagged `requiresMfa` (Super Admin etc). Keep `true` in production.
AUTH_ENFORCE_MFA=true
# Login lockout policy
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# --- Storage -----------------------------------------------------------------
# "local" (writes to ./public/uploads — dev only) or "s3" (any S3-compatible provider)
STORAGE_DRIVER=local
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_VIDEO_MB=40
UPLOAD_MAX_MODEL_MB=20
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for objects (CDN), e.g. https://cdn.example.com
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# --- Seeding (development only) ---------------------------------------------
# Seed fictional demo content (fighters, events, rankings...). Clearly flagged as DEMO.
SEED_DEMO=true
# Create one demo account per role (refused when NODE_ENV=production). Password must be provided here.
SEED_DEMO_USERS=false
DEMO_USER_PASSWORD=

# --- Bootstrap admin (one-time) ---------------------------------------------
# Optional non-interactive bootstrap (CI). Prefer the interactive CLI: npm run admin:bootstrap
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Tests -------------------------------------------------------------------
TEST_DATABASE_URL=mysql://boxing:change-me@localhost:3307/boxing_test

